# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for the AI coach feature. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-6 if not set
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — server port, defaults to 3001
PORT=3001

# Optional — where the SQLite file lives, defaults to ./data/trainingscoach.db
DATA_DIR=./data

# Only needed once you register a real Strava API app and set up the webhook
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=changeme
