# Copy this file to .env and fill in real values. Never commit .env itself.

# ---------------------------------------------------------------------------
# AI-coach: kies je provider
# ---------------------------------------------------------------------------
# Laat LLM_PROVIDER leeg om automatisch te kiezen: staat er een GEMINI_API_KEY,
# dan wordt Gemini gebruikt, anders Anthropic. Vul 'anthropic' of 'gemini' in
# om het expliciet vast te zetten (handig als je beide sleutels hebt staan).
LLM_PROVIDER=

# --- Optie 1: Google Gemini (gratis tier, geen creditcard nodig) ------------
# Sleutel ophalen: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Optioneel. Modelnamen bij Google veranderen regelmatig en oudere modellen
# worden afgesloten voor nieuwe accounts. Werkt dit niet, vraag dan op welke
# modellen jouw sleutel mag gebruiken:
#   curl -s -H "x-goog-api-key: JOUW_SLEUTEL" \
#     https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
GEMINI_MODEL=gemini-3-flash-preview

# --- Optie 2: Anthropic (betaald per gebruik) ------------------------------
# Sleutel ophalen: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optioneel, standaard claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Optioneel — server-poort, standaard 3001
PORT=3001

# Optioneel — waar het SQLite-bestand staat, standaard ./data/trainingscoach.db
DATA_DIR=./data

# Optioneel — hoeveel dagelijkse back-ups bewaard blijven in DATA_DIR/backups,
# standaard 30. De server schrijft er elke nacht één.
# BACKUP_KEEP_DAYS=30

# Optioneel — laat de interface vanaf een ander adres met deze API praten.
# LAAT DIT LEEG tenzij je het echt nodig hebt: deze server kent geen wachtwoord,
# dus alles wat hem kan bereiken kan je hele geschiedenis lezen en wissen. Staat
# dit uit, dan weigert je browser verzoeken vanaf andere websites. Vul nooit "*"
# in; gebruik het exacte adres, bijvoorbeeld http://192.168.1.20:5173
# CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Kostenrem op de AI-coach
# ---------------------------------------------------------------------------
# Elke coachaanvraag is een betaalde modelaanroep. Deze grenzen vangen een
# vastgelopen automatische taak of driftig klikken op; bij normaal gebruik merk
# je er niets van.
# COACH_MIN_SECONDS_BETWEEN=5
# COACH_MAX_CALLS_PER_DAY=50

# ---------------------------------------------------------------------------
# Garmin (alleen nodig voor automatisch ophalen van herstelgegevens)
# ---------------------------------------------------------------------------
# Garmin heeft geen API voor particulieren, en de onofficiele bibliotheek kan
# sinds maart 2026 geen sessie meer bewaren. Elke run moet dus opnieuw
# inloggen, en een cron-taak kan geen wachtwoord vragen. Wil je automatisch
# ophalen, zet je gegevens dan hier neer.
#
# Afweging: je wachtwoord staat dan leesbaar op de Pi (in een bestand dat niet
# in git terechtkomt). Vind je dat niet acceptabel, laat deze leeg en draai het
# script handmatig -- dat werkt prima.
#
# Let op: dit werkt niet als je tweestapsverificatie aan hebt staan.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Strava (alleen nodig zodra je de webhook opzet)
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=changeme
